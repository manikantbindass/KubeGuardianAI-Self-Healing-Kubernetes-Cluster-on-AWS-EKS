# COPY, review and replace every placeholder before planning. No credentials belong here.
region = "ap-south-1"
allowed_account_ids = ["000000000000"]
owner = "REPLACE_WITH_OWNER"
name = "sentinel-dev"
cidr = "10.42.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b"]
kubernetes_version = "1.34"
# Replace with a compatible AL2023 x86_64 EKS AMI release obtained via read-only SSM lookup.
node_ami_release = "1.34.0-20000101"
# Replace each with an actual region/version-compatible EKS addon build. Do not use these sentinels.
addons = {
  vpc-cni = "v0.0.0-eksbuild.0"
  kube-proxy = "v0.0.0-eksbuild.0"
  coredns = "v0.0.0-eksbuild.0"
  eks-pod-identity-agent = "v0.0.0-eksbuild.0"
}
autoscaling_service_linked_role_arn = "arn:aws:iam::000000000000:role/aws-service-role/autoscaling.amazonaws.com/AWSServiceRoleForAutoScaling"
# Existing federated roles, never users/session ARNs; namespace-scoped access only.
view_principal_arns = []
deploy_principal_arns = []
# GitHub publisher is disabled until existing OIDC provider/account/branch are reviewed.
enable_github_role = false
github_oidc_provider_arn = ""
