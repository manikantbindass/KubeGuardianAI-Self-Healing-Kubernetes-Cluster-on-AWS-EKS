# Local development only. Never use this example password on a public service.
APP_ENV=local
LOG_LEVEL=INFO
DASHBOARD_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_local
POSTGRES_DB=sentinel
# Native API/worker/migrator read these from repository-root .env.
# Compose overrides them with service DNS; container ports stay 5432/6379.
DATABASE_URL=postgresql+psycopg://sentinel:sentinel_local@127.0.0.1:5432/sentinel
REDIS_URL=redis://127.0.0.1:6379/0
# JSON list, explicit origins only; authentication is handled by the same-origin BFF.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Native Next.js reads this only from its process environment or apps/dashboard/.env.local.
# Compose always uses http://api:8000, not this host URL.
API_BASE_URL=http://127.0.0.1:8000
# Phase 04/05 native telemetry. Empty tokens disable ingestion/publishing.
PROMETHEUS_URL=http://127.0.0.1:9090
TELEMETRY_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
DETECTOR_MODEL_PATH=.cache/ml/model.json
DETECTOR_WINDOW_SECONDS=60
DETECTOR_QUEUE_SIZE=16
DETECTOR_TIMEOUT_SECONDS=10
DETECTOR_INCIDENT_API=http://127.0.0.1:8000
DETECTOR_PUBLISH_ENABLED=false
# Separate client-to-detector and detector-to-backend credentials required for publishing.
DETECTOR_API_TOKEN=
DETECTOR_TELEMETRY_TOKEN=
# Phase 07: deployed installations default to real API data and fail-closed OIDC authentication.
# For trusted local auth explicitly run: uv run python scripts/setup/operations_env.py --development
OPS_AUTH_MODE=oidc
OPS_DEV_TOKEN=
OPS_DEV_VIEWER_TOKEN=
OPS_BRIDGE_TOKEN=
OPS_DEMO_ENABLED=false
OPS_APPROVAL_KEY_PATH=
OPS_APPROVAL_KEY_ID=dashboard-approver
OPS_DETECTOR_URL=
OPS_OIDC_AUDIENCE=kubesentinel-api
OPS_OIDC_JWKS_URL=
OPS_OIDC_ROLES_CLAIM=kubesentinel_roles
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_SESSION_SECRET=
APP_PUBLIC_URL=http://localhost:3000
APP_COOKIE_SECURE=false

# Optional Loki endpoint; must receive k8s_namespace_name/k8s_pod_name metadata.
OPS_LOKI_URL=
# Comma-free JSON namespace allowlist shared with the bridge.
OPS_NAMESPACES=["kubesentinel","sentinel-lab"]
# Generated native Linux key-owner IDs; non-root only.
OPS_RUNTIME_UID=10001
OPS_RUNTIME_GID=10001

# Per-process PostgreSQL connection ceiling = pool size + overflow.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
QUEUE_MAX_PENDING=1000

# Optional recovery escalation delivery; disabled until explicitly configured.
# HTTPS hostname on port 443 plus a public numeric IP pinned by the operator.
ESCALATION_ENABLED=false
ESCALATION_URL=
ESCALATION_IP=
# At least 32 random bytes; supply out of band, never commit the value.
ESCALATION_SIGNING_SECRET=
ESCALATION_MAX_ATTEMPTS=5
ESCALATION_MAX_PENDING=1000
ESCALATION_TIMEOUT_SECONDS=3
