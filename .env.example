# Local development only. Never use this example password on a public service.
APP_ENV=local
LOG_LEVEL=INFO
DASHBOARD_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_local
POSTGRES_DB=sentinel
# Native API/worker/migrator read these from repository-root .env.
# Compose overrides them with service DNS; container ports stay 5432/6379.
DATABASE_URL=postgresql+psycopg://sentinel:sentinel_local@127.0.0.1:5432/sentinel
REDIS_URL=redis://127.0.0.1:6379/0
# JSON list, explicit origins only. No credentials are accepted in Phase 01.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Native Next.js reads this only from its process environment or apps/dashboard/.env.local.
# Compose always uses http://api:8000, not this host URL.
API_BASE_URL=http://127.0.0.1:8000
